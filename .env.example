# MODELO — copie para .env e preencha com os valores reais.
# Este arquivo é versionado: nunca coloque credencial de verdade aqui.

# Supabase > Connect > Direct > Transaction pooler > URI (porta 6543)
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-1-sa-east-1.pooler.supabase.com:6543/postgres

# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-isto

# Chave da OpenRouter (https://openrouter.ai/keys). Gratuita, sem cartão —
# o guardrail em llm.py bloqueia qualquer modelo que não seja :free.
OPENROUTER_API_KEY=sua-chave-aqui
